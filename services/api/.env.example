# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/amber_grain?schema=public"

# HTTP port for the API
PORT=3001

# Supabase Storage — item image uploads (optional; uploads 503 if unset).
# Service-role key is SECRET (server only). Dashboard > Project Settings > API.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="menu-images"
