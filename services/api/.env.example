# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (Prisma)
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────
# Prisma RUNTIME connection — DIRECT Postgres (5432) with a capped pool.
# Benchmarked 2026-07-17 (perf pass 3, dev query log, same payloads) against
# the transaction-mode pgBouncer pooler (6543, pgbouncer=true): the pooler
# wraps EVERY query in BEGIN + DEALLOCATE ALL + COMMIT and disables prepared
# statements, so each query cost ~180–200ms vs ~100ms direct (Singapore-RTT
# floor from India). Endpoint walls: open-table-ids ~460→~100ms, staff
# GET /orders ~1.0s→~0.42s, addRound (13 round-trips) ~2.7s→~1.7s. Burst test
# on direct (6 concurrent addRounds + 4 held SSE streams + admin tabs + KDS):
# max wall 3.7s, no single query over 242ms, no 5xx/P2024 — BUG-003's pool
# queueing did not reappear at connection_limit=8. Direct Postgres allows ~60
# clients: keep (API instances × connection_limit) well under that — do NOT
# run extra long-lived API copies against it.
# NOTE: if your DB password contains "@", percent-encode it as %40.
DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?connection_limit=8"

# POOLER fallback — for networks where db.<project-ref>.supabase.co doesn't
# resolve, or when running many API instances. TRANSACTION MODE (6543);
# `pgbouncer=true` is REQUIRED (disables Prisma's prepared statements, which
# transaction-mode pgBouncer can't support — omitting it causes query errors).
# No connection_limit/pool_timeout needed in this mode. Expect the per-query
# wrapper tax above.
# DATABASE_URL="postgresql://postgres:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection — used ONLY by `prisma db push` / migrations (needs a
# non-pooled session). Same password, no ?connection_limit param.
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# ─────────────────────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────────────────────
PORT=3001

# REQUIRED for local development: opens CORS to all origins and enables the dev
# JWT fallback. Without this (and with CORS_ORIGINS empty) the API answers every
# browser preflight WITHOUT Access-Control-Allow-Origin → the apps fail with a
# CORS error on login. ⚠️ REMOVE (or set to "production" + fill CORS_ORIGINS and
# JWT_SECRET) on any real deployment.
NODE_ENV=development

# Comma-separated list of allowed browser origins for CORS (production/staging).
# Ignored only in explicit local dev (NODE_ENV=development or ALLOW_INSECURE_DEV=true),
# where all origins are allowed for LAN testing.
CORS_ORIGINS=""

# Explicit opt-in to the INSECURE dev fallbacks (hardcoded JWT secret + open
# CORS). Leave UNSET on any real deployment: the API refuses to boot without a
# real JWT_SECRET unless this is "true" or NODE_ENV=development. This closes the
# old fail-open gap where a forgotten NODE_ENV silently ran the public dev secret.
ALLOW_INSECURE_DEV=""

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE — shared project (storage + auth)
# Dashboard > Project Settings > API
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL="https://<project-ref>.supabase.co"

# Service-role key — SECRET, server-only. Used for: menu image uploads to
# Supabase Storage, and creating seed users via the Supabase Admin API.
# Dashboard > Project Settings > API > service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=""

# Storage bucket for menu item images (auto-created on boot if missing).
SUPABASE_BUCKET="menu-images"

# ─────────────────────────────────────────────────────────────────────────────
# AUTH — Supabase JWT verification
# The API's AuthGuard verifies incoming Supabase session tokens using this
# secret (HMAC-SHA256). Find it at:
#   Dashboard > Project Settings > API > JWT Settings > "JWT Secret"
# (the long base64 string shown there — NOT the anon/service-role key)
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_JWT_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# AUTH — impersonation-only custom JWT
# These are used ONLY to sign/verify our own short-lived impersonation tokens
# (POST /admin/impersonate). They are separate from the Supabase JWT secret.
# Generate JWT_SECRET with:  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=""
JWT_EXPIRES_IN="30m"

# ─────────────────────────────────────────────────────────────────────────────
# AUTH — master-password impersonation
# Platform operators supply this in addition to their super-admin session to
# impersonate a tenant. Treat like a root credential: long, random, rotated.
# Generate with:  openssl rand -base64 32
# ⚠️ Never paste a real value into this file — keep it only in your real .env.
# ─────────────────────────────────────────────────────────────────────────────
PLATFORM_MASTER_PASSWORD=""

# ─────────────────────────────────────────────────────────────────────────────
# SEED — super-admin bootstrap
# prisma/seed.ts calls the Supabase Admin API (service-role key) to create a
# Supabase auth user with these credentials, then creates the matching Prisma
# User row (isSuperAdmin: true). Run `pnpm db:seed` after filling these in.
# ─────────────────────────────────────────────────────────────────────────────
SUPER_ADMIN_SEED_EMAIL=""
SUPER_ADMIN_SEED_PASSWORD=""

# ─────────────────────────────────────────────────────────────────────────────
# AUTH — platform super-admin allowlist
# Comma-separated list of emails allowed to become platform super-admins via
# POST /auth/sync-profile. A valid Supabase session is NOT enough — the email
# must be on this list, or the request is rejected (403). Leave empty to forbid
# all self-bootstrap (the seed script provisions the first operator directly).
# ─────────────────────────────────────────────────────────────────────────────
SUPERADMIN_EMAILS=""
