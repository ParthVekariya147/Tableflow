# Super-admin (Vite) — copy to .env.local for machine-specific overrides.
# Never commit .env.local.

# ─────────────────────────────────────────────────────────────────────────────
# PLATFORM API
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE AUTH (browser client)
# Must be the SAME Supabase project as services/api/.env SUPABASE_URL.
# The anon key is safe to ship to the browser (Supabase enforces auth via
# RLS/JWT, not key secrecy). Use "anon public", NOT service_role.
# Dashboard > Project Settings > API.
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# IMPERSONATION
# restaurant-admin origin — opened in a new tab when a super-admin clicks
# "Impersonate" on a tenant. Must match VITE_CUSTOMER_URL in the admin env.
# ─────────────────────────────────────────────────────────────────────────────
VITE_RESTAURANT_ADMIN_URL=http://localhost:5174
