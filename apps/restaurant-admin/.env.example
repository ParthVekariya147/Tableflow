# Restaurant-admin (Vite) environment — copy to .env.local for overrides.

# Platform API base URL (services/api).
VITE_API_URL=http://localhost:3001

# KDS relay base URL (live kitchen board transport).
VITE_KDS_URL=http://localhost:4001

# Where the customer ordering PWA is deployed. Used to build the scannable
# table QR codes: <VITE_CUSTOMER_URL>/<tenantSlug>/t/<qrToken>.
VITE_CUSTOMER_URL=http://localhost:5173
