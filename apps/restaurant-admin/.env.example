# Restaurant-admin (Vite) — copy to .env.local for machine-specific overrides.
# Never commit .env.local.

# ─────────────────────────────────────────────────────────────────────────────
# PLATFORM API
# ─────────────────────────────────────────────────────────────────────────────
# Base URL for services/api (NestJS backend).
VITE_API_URL=http://localhost:3001

# KDS relay base URL (live kitchen board transport).
VITE_KDS_URL=http://localhost:4001

# Customer ordering PWA origin — baked into scannable table QR codes:
#   <VITE_CUSTOMER_URL>/<tenantSlug>/t/<qrToken>
VITE_CUSTOMER_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE AUTH (browser client)
# Must be the SAME Supabase project as services/api/.env SUPABASE_URL.
# The anon key is safe to ship to the browser — Supabase enforces auth via
# RLS/JWT, not key secrecy. Use the "anon public" key, NOT service_role.
# Dashboard > Project Settings > API.
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
