{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "NestJS Service",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "isolatedModules": false,
    "noEmit": false,
    "outDir": "dist"
  }
}
