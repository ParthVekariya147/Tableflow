{
  "name": "amber-grain",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant restaurant ordering platform. One codebase, many branded tenants.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "node tools/dev.mjs",
    "dev:apps": "turbo run dev",
    "dev:kds-relay": "node tools/kds-relay.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @amber/api prisma:generate",
    "db:migrate": "pnpm --filter @amber/api prisma:migrate",
    "db:seed": "pnpm --filter @amber/api prisma:seed",
    "db:seed:super-admin": "pnpm --filter @amber/api prisma:seed:super-admin"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "multer": ">=2.2.0",
      "qs": ">=6.15.2",
      "file-type": ">=21.3.2"
    }
  }
}
